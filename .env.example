# .env.example — Safe template for environment variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env — it is listed in .gitignore.
# Only .env.example (no real secrets) should be committed.

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=REPLACE_ME

# ─── Authentication ──────────────────────────────────────────────────────────
JWT_SECRET=REPLACE_ME
SESSION_SECRET=REPLACE_ME

# ─── Third-party APIs ────────────────────────────────────────────────────────
API_KEY=REPLACE_ME
STRIPE_SECRET_KEY=REPLACE_ME

# ─── Cloud Providers ─────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=REPLACE_ME
AWS_SECRET_ACCESS_KEY=REPLACE_ME
AWS_REGION=us-east-1

# ─── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=REPLACE_ME
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_ME
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME

# ─── SecretShield Dashboard ───────────────────────────────────────────────────
# The dashboard stores your GitHub PAT in the browser's localStorage.
# No environment variables are required to deploy the dashboard to Vercel.
# Set GITHUB_TOKEN in your workflow secrets for the Action itself.
